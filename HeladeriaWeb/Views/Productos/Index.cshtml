@{
    ViewData["Title"] = "Catálogo de Productos";
    var productos = Model as IEnumerable<dynamic>;
}

<div class="container mt-4">
    <h2>🍨 Catálogo de Helados</h2>
    <hr />

    <table class="table table-striped table-bordered bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (productos != null && productos.Any())
            {
                @foreach (var item in productos)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Categoria</td>
                        <td>$@item.PrecioVenta.ToString("0.00")</td>
                        <td>
                            <form asp-controller="Carrito" asp-action="Agregar" method="post" class="d-inline">
                                <input type="hidden" name="productoId" value="@item.IdProducto" />
                                <input type="hidden" name="cantidad" value="1" />
                                <button type="submit" class="btn btn-sm btn-primary">🛒 Agregar al Carrito</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No hay productos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - HeladeríaWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow p-4 rounded-4" style="width: 100%; max-width: 400px;">
        <div class="text-center mb-4">
            <h1 class="h3 fw-bold text-danger">🍨 HeladeríaWeb</h1>
            <p class="text-muted">Ingresa tu correo para hacer tu pedido</p>
        </div>

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">Correo Electrónico</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="carlos@heladeria.com" required />
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">🚀 Ingresar al Sitio</button>
        </form>
    </div>

</body>
</html>
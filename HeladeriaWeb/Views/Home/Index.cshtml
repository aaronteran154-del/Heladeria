@{
    ViewData["Title"] = "Inicio";
}

<div class="container my-5">
    <!-- Hero Section / Banner Principal -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border text-center">
        <div class="container-fluid py-3">
            <h1 class="display-4 fw-bold text-danger">🍨 ¡Bienvenidos a HeladeríaWeb!</h1>
            <p class="col-md-8 fs-4 mx-auto text-muted">
                Los mejores helados artesanales, malteadas y postres hechos para endulzar tu día. ¡Descubre nuestro catálogo y arma tu pedido al instante!
            </p>
            <div class="mt-4">
                <a class="btn btn-primary btn-lg px-4 me-2" asp-controller="Productos" asp-action="Index">
                    🍧 Ver Catálogo
                </a>
                <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="Carrito" asp-action="Index">
                    🛒 Ver Carrito
                </a>
            </div>
        </div>
    </div>

    <!-- Sección de Características / Tarjetas -->
    <div class="row text-center g-4 py-2">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="fs-1 mb-2">🍦</div>
                    <h3 class="h5 fw-bold">Variedad Exquisita</h3>
                    <p class="text-muted">Explora nuestra gran selección de sabores, conos y postres recién preparados.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="fs-1 mb-2">⭐</div>
                    <h3 class="h5 fw-bold">Club de Clientes</h3>
                    <p class="text-muted">Regístrate y acumula puntos de fidelidad con cada compra para obtener sorpresas.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="fs-1 mb-2">🚀</div>
                    <h3 class="h5 fw-bold">Pedidos Rápidos</h3>
                    <p class="text-muted">Un sistema ágil de carrito de compras integrado directamente con nuestra base de datos.</p>
                </div>
            </div>
        </div>
    </div>
</div>
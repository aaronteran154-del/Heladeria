@{
    ViewData["Title"] = "Catálogo de Clientes";
    var clientes = Model as IEnumerable<dynamic>;
}

<div class="container mt-4">
    <h2>👥 Listado de Clientes</h2>
    <hr />

    <table class="table table-striped table-bordered bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Puntos de Fidelidad</th>
            </tr>
        </thead>
        <tbody>
            @if (clientes != null && clientes.Any())
            {
                @foreach (var item in clientes)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Telefono</td>
                        <td>@item.Email</td>
                        <td>@item.PuntosFidelidad</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No hay clientes registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
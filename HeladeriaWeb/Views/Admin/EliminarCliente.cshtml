@model dynamic

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 p-4 bg-white text-center">
                <div class="fs-1 mb-2">⚠️</div>
                <h2 class="fw-bold text-danger mb-3">¿Estás seguro de eliminar este cliente?</h2>
                <p class="text-muted">Esta acción no se puede deshacer y borrará los datos del registro.</p>

                <div class="card bg-light border-0 p-3 mb-4 text-start">
                    <p class="mb-1"><strong>Nombre:</strong> @Model.Nombre</p>
                    <p class="mb-0"><strong>Correo:</strong> @Model.Email</p>
                </div>

                <form asp-action="EliminarClienteConfirmado" method="post">
                    <input type="hidden" name="id" value="@Model.IdCliente" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Clientes" class="btn btn-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">Sí, Eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@model dynamic

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-white p-4">
                <h2 class="fw-bold text-success mb-4 text-center">➕ Nuevo Producto</h2>

                <form asp-action="CrearProducto" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre</label>
                        <input type="text" name="Nombre" class="form-control" required placeholder="Ej. Helado de Morocho" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Categoría</label>
                        <input type="text" name="Categoria" class="form-control" required placeholder="Ej. Tradicional" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Precio de Venta ($)</label>
                        <input type="number" step="0.01" name="PrecioVenta" class="form-control" required placeholder="0.00" />
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Productos" class="btn btn-secondary">← Cancelar</a>
                        <button type="submit" class="btn btn-success fw-bold">💾 Guardar Producto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@model dynamic

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-white p-4">
                <h2 class="fw-bold text-danger mb-4 text-center">✏️ Editar Cliente</h2>

                <form asp-action="EditarCliente" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Campo oculto indispensable para enviar el ID del cliente -->
                    <input type="hidden" name="IdCliente" value="@Model.IdCliente" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre</label>
                        <input type="text" name="Nombre" value="@Model.Nombre" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email / Correo</label>
                        <input type="text" name="Email" value="@Model.Email" class="form-control" required />
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Clientes" class="btn btn-secondary">← Cancelar</a>
                        <button type="submit" class="btn btn-danger fw-bold">💾 Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
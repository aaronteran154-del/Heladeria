@model dynamic

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-white p-4">
                <h2 class="fw-bold text-warning mb-4 text-center">✏️ Editar Producto</h2>

                <form asp-action="EditarProducto" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Campo oculto para enviar el ID al controlador -->
                    <input type="hidden" name="IdProducto" value="@Model.IdProducto" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre</label>
                        <input type="text" name="Nombre" value="@Model.Nombre" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Categoría</label>
                        <input type="text" name="Categoria" value="@Model.Categoria" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Precio de Venta ($)</label>
                        <input type="number" step="0.01" name="PrecioVenta" value="@Model.PrecioVenta" class="form-control" required />
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Productos" class="btn btn-secondary">← Cancelar</a>
                        <button type="submit" class="btn btn-warning fw-bold text-dark">💾 Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@using HeladeriaWeb.Models;
@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Administrar Productos";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger">🍨 Gestión de Productos</h2>
        <!-- Botón para ir al formulario de creación -->
        <a asp-controller="Admin" asp-action="CrearProducto" class="btn btn-success fw-bold shadow-sm">
            ➕ Nuevo Producto
        </a>
    </div>

    <div class="card shadow-sm border-0 bg-white p-3">
        <table class="table table-striped table-bordered bg-white align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Categoria</td>
                            <!-- Usamos PrecioVenta que es el nombre correcto en tu modelo -->
                            <td>$@item.PrecioVenta</td>
                            <td class="text-center">
                                <a asp-controller="Admin" asp-action="EditarProducto" asp-route-id="@item.IdProducto" class="btn btn-warning btn-sm fw-bold">✏️ Editar</a>
                                <a asp-controller="Admin" asp-action="EliminarProducto" asp-route-id="@item.IdProducto" class="btn btn-danger btn-sm fw-bold">🗑️ Borrar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No hay productos registrados en el sistema.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a class="btn btn-secondary" asp-controller="Admin" asp-action="Index">← Volver al Panel Admin</a>
    </div>
</div>
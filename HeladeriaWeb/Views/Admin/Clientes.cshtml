@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Administrar Clientes";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger">👥 Gestión de Clientes</h2>
        <!-- Botón para ir al formulario de creación -->
        <a asp-controller="Admin" asp-action="CrearCliente" class="btn btn-success fw-bold shadow-sm">
            ➕ Nuevo Cliente
        </a>
    </div>

    <div class="card shadow-sm border-0 bg-white p-3">
        <table class="table table-striped table-bordered bg-white align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Puntos de Fidelidad</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Telefono</td>
                            <td>@item.Email</td>
                            <td>@item.PuntosFidelidad</td>
                            <td class="text-center">
                                <a asp-controller="Admin" asp-action="EditarCliente" asp-route-id="@item.IdCliente" class="btn btn-warning btn-sm fw-bold">✏️ Editar</a>
                                <a asp-controller="Admin" asp-action="EliminarCliente" asp-route-id="@item.IdCliente" class="btn btn-danger btn-sm fw-bold">🗑️ Borrar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No hay clientes registrados en el sistema.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a class="btn btn-secondary" asp-controller="Admin" asp-action="Index">← Volver al Panel Admin</a>
    </div>
</div>